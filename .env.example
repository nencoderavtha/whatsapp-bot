# ================================================================
# AI Provider  (all OpenAI-compatible — pick one)
# ================================================================
# auto-picks the first provider that has a key, in this order:
#   openrouter → groq → cerebras → gemini
# Set AI_PROVIDER explicitly to force a specific one.
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=        # https://openrouter.ai/keys
GROQ_API_KEY=              # https://console.groq.com/keys  (free 100k tokens/day)
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai      (free backup)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey

# Leave blank to use the provider's default model:
#   openrouter → google/gemini-2.5-flash
#   groq       → llama-3.3-70b-versatile
#   cerebras   → gpt-oss-120b
#   gemini     → gemini-2.5-flash
AI_MODEL=

# ================================================================
# Database — Supabase (PostgreSQL)
# ================================================================
# Supabase → Project Settings → Database → Connection string
# Use the "Transaction pooler" URL (port 6543) — required for Prisma.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ================================================================
# Admin portal
# ================================================================
ADMIN_PORT=4000
ADMIN_PASSWORD=changeme     # change this — used to protect the admin dashboard

# ================================================================
# WhatsApp
# ================================================================
# baileys = free QR login (demo/dev). cloud = official Meta API (production). kapso = Kapso developer gateway.
WHATSAPP_PROVIDER=baileys

# Only needed when WHATSAPP_PROVIDER=cloud or kapso:
WHATSAPP_CLOUD_TOKEN=       # Meta permanent token (if cloud provider)
WHATSAPP_PHONE_NUMBER_ID=   # Meta/Kapso phone number ID
WHATSAPP_VERIFY_TOKEN=my-verify-token

# Voice-note transcription (Telugu/Hindi/English code-switched speech)
SARVAM_API_KEY=             # https://sarvam.ai — required for voice notes to work at all

# Only needed when WHATSAPP_PROVIDER=kapso:
KAPSO_API_KEY=              # Kapso dashboard API key (if proxying via Kapso client)
SERVER_URL=                 # Public HTTPS url of this server (for CTA buttons pointing to menu/pay pages)

# ================================================================
# NOTE: Restaurant name, city, and owner numbers are now stored
# in the database (BotConfig table) and editable from the admin
# dashboard. No env vars needed for those anymore.
# ================================================================
