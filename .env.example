# ---- AI provider (all OpenAI-compatible) ----
# Set AI_PROVIDER to openrouter | groq | cerebras (or leave blank to auto-pick the
# first one with a key, in that order). Set the matching API key below.
#   openrouter — instant, no waitlist, cheap pay-as-you-go: https://openrouter.ai/keys
#   groq       — free tier (100k tokens/day cap): https://console.groq.com/keys
#   cerebras   — free tier backup: https://cloud.cerebras.ai
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Leave AI_MODEL blank to use the provider's default
# (openrouter: meta-llama/llama-3.3-70b-instruct, groq: llama-3.3-70b-versatile, cerebras: gpt-oss-120b)
AI_MODEL=

# ---- Database ----
# Dev: SQLite (zero setup). Prod: switch to a Postgres URL and update prisma/schema.prisma datasource.
DATABASE_URL="file:./dev.db"

# ---- Admin portal ----
ADMIN_PORT=4000
# Password to log in to the admin portal (change this!)
ADMIN_PASSWORD=changeme

# ---- WhatsApp ----
# baileys = free QR login (demo). cloud = official Meta WhatsApp Cloud API (production).
WHATSAPP_PROVIDER=baileys

# Only needed when WHATSAPP_PROVIDER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my-verify-token

# ---- Restaurant ----
RESTAURANT_NAME="Military Rajamma Hotel"
RESTAURANT_CITY="Hyderabad"
# Comma-separated admin/owner phone numbers (with country code, no +) for order alerts
OWNER_NUMBERS=
