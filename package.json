{
  "name": "godavari-ruchulu-bot",
  "version": "0.1.0",
  "description": "WhatsApp AI ordering agent for Godavari Ruchulu, Hyderabad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "prisma db push && tsx prisma/seed.ts && tsx src/index.ts",
    "admin": "tsx src/admin/server.ts",
    "bot": "tsx src/whatsapp/run.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mcp:delivery": "tsx src/mcp/delivery-server.ts",
    "test:unit": "tsx --test tests/unit.test.ts tests/production-features.test.ts tests/welcome-card.test.ts tests/token-counter.test.ts tests/notification-center.test.ts",
    "build": "prisma generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@kapso/whatsapp-cloud-api": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.5.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.42.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@whiskeysockets/baileys@6.7.23": true,
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.2": true,
    "sharp@0.34.5": true
  }
}
