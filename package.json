{
  "name": "military-rajamma-bot",
  "version": "0.1.0",
  "description": "WhatsApp AI ordering agent for Military Rajamma Hotel, Hyderabad",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "prisma db push && tsx prisma/seed.ts && tsx src/index.ts",
    "admin": "tsx src/admin/server.ts",
    "bot": "tsx src/whatsapp/run.ts",
    "chat": "tsx src/chat-test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.5.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.2.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.42.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
