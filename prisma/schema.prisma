// Prisma schema for Military Rajamma Hotel WhatsApp bot.
// Dev uses SQLite. For production, change `provider` to "postgresql"
// and point DATABASE_URL at your Postgres instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // transaction pooler — used by the app
  directUrl = env("DIRECT_URL")     // session pooler — used by prisma db push / seed
}

// ---------------- Menu (the "dynamic memory") ----------------

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  sortOrder    Int        @default(0)
  restaurant   BotConfig  @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  items        MenuItem[]

  @@unique([name, restaurantId])
}

model MenuItem {
  id           Int                @id @default(autoincrement())
  name         String
  description  String?
  price        Float              // base price; ignored when item has variants
  available    Boolean            @default(true)
  stockCount   Int?               // null = unlimited; 0 = sold out; >0 = units remaining
  isVeg        Boolean            @default(false)
  spiceLevel   String?
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   Int
  restaurant   BotConfig          @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  orderItems   OrderItem[]
  variants     MenuItemVariant[]

  @@index([categoryId])
  @@index([restaurantId])
}

// e.g. Half / Full / Family Pack / Small / Large for a single MenuItem
model MenuItemVariant {
  id           Int       @id @default(autoincrement())
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId   Int
  restaurant   BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  name         String    // "Half", "Full", "Family Pack"
  price        Float
  available    Boolean   @default(true)
  sortOrder    Int       @default(0)
  orderItems   OrderItem[]

  @@index([restaurantId])
}

// ---------------- Customers & conversation memory ----------------

model Customer {
  id               Int           @id @default(autoincrement())
  phone            String
  name             String?
  address          String?
  notes            String?
  // Set when the customer (or a tool) requests a human. While non-null the AI is
  // paused for this customer and staff reply from the dashboard until they Resume AI.
  humanRequestedAt DateTime?
  createdAt        DateTime      @default(now())
  restaurant       BotConfig     @relation(fields: [restaurantId], references: [id])
  restaurantId     Int
  messages         Message[]
  orders           Order[]
  pendingOrder     PendingOrder?
  activityLogs     ActivityLog[]

  @@unique([phone, restaurantId])
}

// Full conversation log = the bot's per-customer long-term memory.
model Message {
  id           Int       @id @default(autoincrement())
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   Int
  restaurant   BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  role         String    // "user" | "assistant"
  content      String
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
}

// ---------------- Orders ----------------

model Order {
  id           Int         @id @default(autoincrement())
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   Int
  restaurant   BotConfig   @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  status       String      @default("pending") // pending | confirmed | preparing | ready | delivered | cancelled
  type         String      @default("pickup")  // pickup | delivery | dine-in
  total        Float       @default(0)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  payment      Payment?

  @@index([restaurantId, status, createdAt])
}

// Payment record — one per order, created when customer confirms payment
model Payment {
  id           Int       @id @default(autoincrement())
  order        Order     @relation(fields: [orderId], references: [id])
  orderId      Int       @unique
  restaurant   BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  status       String    @default("pending")  // pending | paid | failed | refunded
  method       String?                        // upi | cash | card | online
  amount       Float
  reference    String?                        // UPI txn ID or other reference
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId, status])
}

model OrderItem {
  id           Int              @id @default(autoincrement())
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      Int
  restaurant   BotConfig        @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  menuItem     MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemId   Int?
  variant      MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId    Int?
  nameSnap     String           // item name at order time
  variantSnap  String?          // variant name at order time (e.g. "Half")
  priceSnap    Float            // price at order time (variant price if applicable)
  qty          Int              @default(1)
  note         String?

  @@index([restaurantId])
}

// ---------------- Bot configuration (editable from admin dashboard) ----------------

model BotConfig {
  id                         Int              @id @default(autoincrement())
  restaurantName             String           @default("Military Rajamma Hotel")
  restaurantCity             String           @default("Hyderabad")
  // Persona the bot speaks as (e.g. "Rajamma"). Null → prompt falls back to
  // "the team at {restaurantName}" phrasing.
  personaName                String?
  ownerNumbers               String           @default("")
  isActive                   Boolean          @default(true)
  dashboardPassword          String           @default("changeme")
  loginUsername              String?          @unique
  // Bot on/off switch
  botPaused                  Boolean          @default(false)
  pauseMessage               String?
  whatsappPhone              String?          // e.g. "919876543210" — if set, uses pairing code instead of QR
  // WhatsApp Cloud API (per-restaurant; token falls back to WHATSAPP_CLOUD_TOKEN env var)
  cloudPhoneNumberId         String?
  cloudToken                 String?
  // Payment settings
  requiresPaymentBeforeOrder Boolean          @default(false)
  upiId                      String?
  paymentMethods             String           @default("cash,upi")
  // Razorpay (per-restaurant — each restaurant has their own account)
  razorpayEnabled            Boolean          @default(false)
  razorpayKeyId              String?
  razorpayKeySecret          String?
  razorpayWebhookSecret      String?
  updatedAt                  DateTime          @updatedAt
  categories                 Category[]
  menuItems                  MenuItem[]
  menuItemVariants           MenuItemVariant[]
  customers                  Customer[]
  messages                   Message[]
  orders                     Order[]
  orderItems                 OrderItem[]
  payments                   Payment[]
  pendingOrders              PendingOrder[]
  promptTemplates            PromptTemplate[]
  toolDefinitions            ToolDefinition[]
  activityLogs               ActivityLog[]
}

// ---------------- Bot health / activity log (dashboard observability) --------
// Records tool errors, fallback triggers, response-time samples, and human
// handoff events. Written fire-and-forget so it never blocks a customer reply.
model ActivityLog {
  id           Int       @id @default(autoincrement())
  restaurant   BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  type         String    // "response_time" | "tool_error" | "fallback" | "human_handoff" | "handoff_resolved"
  message      String
  meta         String?   // optional JSON blob (e.g. {"elapsedMs":842})
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId   Int?
  createdAt    DateTime  @default(now())

  @@index([restaurantId, createdAt])
}

model PromptTemplate {
  id           Int       @id @default(autoincrement())
  content      String
  restaurant   BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  updatedAt    DateTime  @updatedAt
}

model ToolDefinition {
  id               Int       @id @default(autoincrement())
  name             String
  description      String
  parametersSchema String    // JSON Schema string
  isEnabled        Boolean   @default(true)
  sortOrder        Int       @default(0)
  restaurant       BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId     Int
  updatedAt        DateTime  @updatedAt

  @@unique([name, restaurantId])
}

// Replaces the in-memory pendingCarts Map — survives restarts and deploys.
model PendingOrder {
  id               Int       @id @default(autoincrement())
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       Int       @unique
  restaurant       BotConfig @relation(fields: [restaurantId], references: [id])
  restaurantId     Int
  lines            String    // JSON: {menuItemId, variantId?, qty, note?}[]
  type             String    @default("pickup")
  note             String?
  confirmedOrderId  Int?
  // Staged payment (set by record_payment, consumed by confirm_order)
  paymentMethod     String?
  paymentReference  String?
  // Razorpay payment link (set by generate_payment_link tool)
  razorpayLinkId    String?
  razorpayLinkUrl   String?
  expiresAt         DateTime
  updatedAt         DateTime  @updatedAt

  @@index([restaurantId])
}

