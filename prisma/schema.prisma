// Production Single-Restaurant Schema for Godavari Ruchulu WhatsApp Bot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Transaction pooler (Port 6543)
  directUrl = env("DIRECT_URL")     // Session pooler (Port 5432)
}

// ============================================================================
// 1. RESTAURANT CONFIGURATION & SETTINGS
// ============================================================================

model RestaurantConfig {
  id                         Int       @id @default(1)
  restaurantName             String    @default("Godavari Ruchulu")
  restaurantCity             String    @default("Hyderabad")
  restaurantAddress          String    @default("Plot 12, Main Road, Gachibowli, Hyderabad")
  restaurantLat              Float?    // Coordinates for delivery distance calculation
  restaurantLng              Float?
  personaName                String?   // e.g. "Rajamma"
  ownerNumbers               String    @default("") // Comma-separated WhatsApp numbers
  isActive                   Boolean   @default(true)
  dashboardPassword          String    @default("changeme")
  loginUsername              String?   @unique
  employeePassword           String?
  botPaused                  Boolean   @default(false)
  pauseMessage               String?
  whatsappPhone              String?   // e.g. "919876543210"

  // Notifications & Emergency Alerts
  emergencyContacts          String?   // Comma-separated WhatsApp numbers, alerted on critical events (payment/refund/delivery failure, human handoff, escalation)
  notificationsEnabled       Boolean   @default(true)
  notificationChannels       String    @default("whatsapp") // Comma-separated: "whatsapp" is the only live channel today; sms/email/push are pluggable stubs
  criticalOnlyMode           Boolean   @default(false)       // When true, only "critical" severity alerts are sent to emergency contacts

  // Welcome Card (WhatsApp greeting) & Web Menu Branding
  welcomeLogoUrl             String?   // Sent as its own image message before the welcome list
  welcomeTagline             String?   // One-line tagline shown under the greeting
  openingHoursText           String?   // Free-text display string, e.g. "Mon-Sun 11am-11pm"
  brandColor                 String?   // Web menu page accent color only — WhatsApp cannot render it
  cloudPhoneNumberId         String?
  cloudToken                 String?
  
  // Payment Config
  requiresPaymentBeforeOrder Boolean   @default(false)
  upiId                      String?
  paymentMethods             String    @default("cash,upi,online")
  razorpayEnabled            Boolean   @default(false)
  razorpayKeyId              String?
  razorpayKeySecret          String?
  razorpayWebhookSecret      String?

  // Delivery Auto-Dispatch Rule
  autoDispatchDelivery       Boolean   @default(true)  // Auto-select best delivery provider by lowest quote/ETA
  defaultDeliveryStrategy    String    @default("CHEAPEST") // "CHEAPEST" | "FASTEST" | "BALANCED"

  // Loyalty Program Rules
  loyaltyEarnRateRupees      Float     @default(100.0) // Earn 1 point per ₹100 spent
  loyaltyRedeemValueRupees   Float     @default(1.0)   // 1 point = ₹1 discount
  minPointsToRedeem          Int       @default(50)    // Min 50 points to redeem

  updatedAt                  DateTime  @updatedAt
}

// ============================================================================
// 2. MENU CATALOG & RECOMMENDATIONS
// ============================================================================

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id           Int                  @id @default(autoincrement())
  name         String
  description  String?
  price        Float                // Base price (ignored if item has variants)
  available    Boolean              @default(true)
  stockCount   Int?                 // null = unlimited; 0 = sold out; >0 = units remaining
  isVeg        Boolean              @default(false)
  spiceLevel   String?              // "Mild" | "Medium" | "Spicy"
  sortOrder    Int                  @default(0)
  pieceInfo    String?              // e.g. "2 pieces"
  imageUrl     String?              // Dish photo URL
  categoryId   Int
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  
  orderItems   OrderItem[]
  variants     MenuItemVariant[]
  
  // Cross-selling pairing recommendations
  primaryPairings   ItemRecommendation[] @relation("PrimaryItem")
  secondaryPairings ItemRecommendation[] @relation("RecommendedItem")

  @@index([categoryId])
}

// Item Variants (e.g. Half / Full / Family Pack)
model MenuItemVariant {
  id         Int         @id @default(autoincrement())
  menuItemId Int
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String      // e.g. "Half", "Full", "Family Pack"
  price      Float
  available  Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@index([menuItemId])
}

// Smart Upsell Pairings (e.g. Biryani recommends Mirchi Ka Salan or Thumbs Up)
model ItemRecommendation {
  id                Int      @id @default(autoincrement())
  menuItemId        Int
  menuItem          MenuItem @relation("PrimaryItem", fields: [menuItemId], references: [id], onDelete: Cascade)
  recommendedItemId Int
  recommendedItem  MenuItem @relation("RecommendedItem", fields: [recommendedItemId], references: [id], onDelete: Cascade)
  pitchMessage      String?  // e.g. "Pairs best with chilled Thumbs Up!"

  @@unique([menuItemId, recommendedItemId])
}

// ============================================================================
// 3. CUSTOMER PROFILES & CHAT MEMORY
// ============================================================================

model Customer {
  id                 Int                  @id @default(autoincrement())
  phone              String               @unique
  name               String?
  address            String?
  deliveryLat        Float?
  deliveryLng        Float?
  favoriteDish       String?
  dietaryPreference  String?              // "veg" | "non_veg"
  notes              String?
  humanRequestedAt   DateTime?            // Live human handoff timestamp
  
  // Analytics Counters
  totalOrdersCount   Int                  @default(0)
  totalSpentRupees   Float                @default(0.0)
  lastOrderedAt      DateTime?

  createdAt          DateTime             @default(now())
  
  messages           Message[]
  orders             Order[]
  pendingOrder       PendingOrder?
  activityLogs       ActivityLog[]
  loyaltyAccount     LoyaltyAccount?
  couponRedemptions  CouponRedemption[]
  campaignRecipients CampaignRecipient[]
  followupTasks      FollowupTask[]
}

// Conversation History Log (30-day rolling window)
model Message {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant"
  content    String   // Text message or Sarvam AI audio transcript
  
  // Media & Voice Support
  mediaType  String   @default("text") // "text" | "audio" | "image"
  mediaUrl   String?  // Supabase Storage URL for original voice note / image

  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// ============================================================================
// 4. ORDERS & DRAFT CARTS
// ============================================================================

model Order {
  id                   Int               @id @default(autoincrement())
  customerId           Int
  customer             Customer          @relation(fields: [customerId], references: [id])
  status               String            @default("pending") // pending | confirmed | preparing | ready | out_for_delivery | delivered | cancelled
  type                 String            @default("pickup")  // pickup | delivery | dine-in
  tokenNumber          Int?              // Daily-resetting display number, e.g. "Order #15" — unique only within businessDate, not globally. Null on rows created before this feature.
  businessDate         String?           // "YYYY-MM-DD" in Asia/Kolkata — the day this order's token was issued for. Null on rows created before this feature.

  subtotal             Float             @default(0)
  discountTotal        Float             @default(0)
  deliveryFee          Float             @default(0)
  loyaltyPointsApplied Int               @default(0)
  loyaltyDiscount      Float             @default(0)
  couponCode           String?
  total                Float             @default(0)
  
  deliveryAddress      String?
  deliveryLat          Float?
  deliveryLng          Float?
  note                 String?
  rejectionReason      String?
  refundStatus         String            @default("none") // none | pending | success | failed
  refundReference      String?
  refundedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  
  items                OrderItem[]
  payment              Payment?
  couponRedemption     CouponRedemption?
  deliveryDispatch     DeliveryDispatch?
  deliveryQuotes       DeliveryQuote[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([businessDate, tokenNumber])
}

// Atomic per-day token counter — one row per (restaurantId, businessDate).
// Incremented via a single INSERT ... ON CONFLICT ... RETURNING round-trip so
// two simultaneous orders can never receive the same token, without needing
// an explicit transaction or advisory lock (see src/services/order.ts).
model DailyTokenCounter {
  restaurantId Int
  businessDate String   // "YYYY-MM-DD" in Asia/Kolkata
  lastToken    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([restaurantId, businessDate])
}

model OrderItem {
  id          Int              @id @default(autoincrement())
  orderId     Int
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  Int?
  menuItem    MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  variantId   Int?
  variant     MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  nameSnap    String           // Price & Name snapshot at time of order
  variantSnap String?
  priceSnap   Float
  qty         Int              @default(1)
  note        String?

  @@index([orderId])
}

// Persistent Draft Cart (Survives app restarts)
/// Where a cart sits in the ordering journey. Routing reads this instead of
/// inferring position from message text, and a cart edit rewinds to the last
/// safe stage rather than restarting the journey.
enum OrderStage {
  BUILDING_CART
  ADDRESS_SELECTED
  QUOTE_GENERATED
  AWAITING_PAYMENT
  ORDER_PLACED
  /// Razorpay reported the link cancelled or the payment failed. The cart is
  /// intact and re-payable — without this the row sat at AWAITING_PAYMENT until
  /// the two-hour TTL, refusing edits the whole time because it looked live.
  PAYMENT_FAILED
  /// The customer abandoned this cart. Terminal, and cleared on the next order.
  CANCELLED
}

model PendingOrder {
  id               Int        @id @default(autoincrement())
  stage            OrderStage @default(BUILDING_CART)
  customerId       Int        @unique
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines            String   // JSON cart lines [{menuItemId, variantId, qty, note}]
  type             String   @default("delivery")
  note             String?
  deliveryFee      Float?   // Quote shown on the final bill; reused when the payment webhook creates the order so the order total matches what was charged.
  appliedCoupon    String?
  redeemedPoints   Int      @default(0)
  confirmedOrderId Int?
  paymentMethod    String?
  paymentReference String?
  razorpayLinkId   String?
  razorpayLinkUrl  String?
  expiresAt        DateTime
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// 5. PAYMENTS
// ============================================================================

model Payment {
  id        Int       @id @default(autoincrement())
  orderId   Int       @unique
  order     Order     @relation(fields: [orderId], references: [id])
  status    String    @default("pending") // pending | paid | failed | refunded
  method    String?                       // upi | cash | razorpay
  amount    Float
  reference String?                       // UPI Ref / Razorpay Payment ID
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

// ============================================================================
// 6. MULTI-PROVIDER DELIVERY INTEGRATION (Rapido, Dunzo, Shadowfax, Uber, Porter)
// ============================================================================

// Provider Credentials & Configuration
model DeliveryProviderConfig {
  id             Int      @id @default(autoincrement())
  providerCode   String   @unique // "rapido" | "dunzo" | "shadowfax" | "uber" | "porter"
  providerName   String   // Display Name (e.g. "Rapido Parcel")
  isEnabled      Boolean  @default(true)
  apiKey         String?
  apiSecret      String?
  merchantId     String?
  webhookSecret  String?
  priorityWeight Int      @default(1) // Priority multiplier for quote comparison
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Comparative Quotes fetched from providers prior to dispatch
model DeliveryQuote {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerCode       String   // "rapido" | "dunzo" | "shadowfax" | "uber" | "porter"
  providerQuoteId    String?  // Quote ID returned by provider API
  quotedFee          Float    // Delivery charge in ₹
  estimatedMinutes   Int      // Estimated delivery time in minutes
  distanceKm         Float?   // Delivery distance in KM
  isAvailable        Boolean  @default(true) // Rider availability status
  expiresAt          DateTime // Quote validity expiration
  isSelected         Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([orderId])
}

// Active Delivery Booking & Real-Time Tracking
model DeliveryDispatch {
  id                 Int       @id @default(autoincrement())
  orderId            Int       @unique
  order              Order     @relation(fields: [orderId], references: [id])
  providerCode       String    // Selected provider ("rapido", "dunzo", "shadowfax", "uber", "porter")
  externalDeliveryId String?   // Waybill / Provider Booking ID
  status             String    @default("SEARCHING_RIDER") // SEARCHING_RIDER | RIDER_ASSIGNED | PICKED_UP | IN_TRANSIT | DELIVERED | CANCELLED | FAILED
  
  deliveryFee        Float     // Final delivery fee charged by provider
  distanceKm         Float?    // Delivery distance
  estimatedMinutes   Int?      // ETA in minutes
  
  // Rider & Vehicle Information
  riderName          String?   // Delivery agent name
  riderPhone         String?   // Delivery agent phone number
  riderVehicleNumber String?   // Bike / Scooter registration number
  riderLat           Float?    // Live GPS latitude
  riderLng           Float?    // Live GPS longitude
  trackingUrl        String?   // Live tracking web URL for customer
  waybillNumber      String?
  
  dispatchedAt       DateTime  @default(now())
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([providerCode, status])
}

// ============================================================================
// 7. COUPONS & DISCOUNTS
// ============================================================================

model Coupon {
  id             Int                @id @default(autoincrement())
  code           String             @unique // e.g. "UGADI20", "WELCOME100"
  description    String?
  discountType   String             // "percentage" | "fixed"
  discountValue  Float              // 20 (% off) or 100 (₹ off)
  minOrderAmount Float              @default(0)
  maxDiscount    Float?             // Cap for percentage discounts (e.g. max ₹150)
  usageLimit     Int?               // Total redemptions allowed
  usedCount      Int                @default(0)
  perUserLimit   Int                @default(1)
  isActive       Boolean            @default(true)
  startsAt       DateTime           @default(now())
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id         Int      @id @default(autoincrement())
  couponId   Int
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    Int      @unique
  order      Order    @relation(fields: [orderId], references: [id])
  discount   Float
  redeemedAt DateTime @default(now())

  @@index([customerId])
}

// ============================================================================
// 8. LOYALTY POINTS PROGRAM
// ============================================================================

model LoyaltyAccount {
  id           Int                  @id @default(autoincrement())
  customerId   Int                  @unique
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointBalance Int                  @default(0)
  totalEarned  Int                  @default(0)
  tier         String               @default("Silver") // Silver | Gold | Platinum
  updatedAt    DateTime             @updatedAt
  
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               Int            @id @default(autoincrement())
  loyaltyAccountId Int
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  type             String         // "EARNED" | "REDEEMED" | "EXPIRED" | "BONUS"
  points           Int            // Positive for earned, negative for redeemed
  description      String
  orderId          Int?
  createdAt        DateTime       @default(now())

  @@index([loyaltyAccountId])
}

// ============================================================================
// 9. FESTIVAL CAMPAIGNS & BROADCAST MARKETING
// ============================================================================

model Campaign {
  id           Int                 @id @default(autoincrement())
  title        String              // e.g. "Ugadi Festival Special 20% Off"
  messageText  String              // WhatsApp broadcast text template
  imageUrl     String?             // Festival promo image banner
  couponCode   String?             // Attached coupon code
  status       String              @default("draft") // draft | scheduled | sending | completed
  targetFilter String              @default("all")   // "all" | "top_spenders" | "inactive_30d"
  scheduledAt  DateTime?
  sentCount    Int                 @default(0)
  createdAt    DateTime            @default(now())
  
  recipients   CampaignRecipient[]
}

model CampaignRecipient {
  id         Int       @id @default(autoincrement())
  campaignId Int
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id])
  status     String    @default("pending") // pending | sent | failed
  sentAt     DateTime?

  @@index([campaignId, status])
}

// ============================================================================
// 10. AUTOMATED FOLLOW-UP TASKS (Cart Recovery, Review Requests)
// ============================================================================

model FollowupTask {
  id         Int      @id @default(autoincrement())
  type       String   // "ABANDONED_CART" | "FEEDBACK_REQUEST" | "REORDER_NUDGE"
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  meta       String?  // JSON payload e.g. {"cartItems": [...], "orderId": 42}
  status     String   @default("pending") // pending | executed | cancelled | failed
  executeAt  DateTime
  createdAt  DateTime @default(now())

  @@index([status, executeAt])
}

// ============================================================================
// 11. OBSERVABILITY & AGENT TOOLS
// ============================================================================

model ActivityLog {
  id         Int       @id @default(autoincrement())
  type       String    // "response_time" | "tool_error" | "fallback" | "human_handoff"
  message    String
  meta       String?   // JSON metadata
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

/// Owner/staff-facing alert — distinct from ActivityLog, which is a bot-ops
/// diagnostic feed (response times, tool errors) read only on the Activity tab.
/// This is the Notification Center's backing store: read/unread state via
/// acknowledgedAt, severity for the bell/badge/toast treatment, and enough
/// delivery bookkeeping (status/retryCount) to log outbound emergency-contact
/// alerts without a separate audit table.
model Notification {
  id             Int       @id @default(autoincrement())
  restaurantId   Int       @default(1)
  type           String    // "order_created" | "payment_failed" | "refund_failed" | "delivery_failed" | "human_handoff" | "order_escalation"
  severity       String    @default("info") // "info" | "warning" | "critical"
  title          String
  message        String
  orderId        Int?
  customerId     Int?
  channel        String?   // "whatsapp" | "sms" | "email" | "push" — channel used for the emergency-contact send attempt, if any
  deliveryStatus String    @default("pending") // pending | sent | failed | skipped (skipped = notifications disabled / no contacts configured)
  retryCount     Int       @default(0)
  acknowledgedAt DateTime? // null = unread
  createdAt      DateTime  @default(now())

  @@index([restaurantId, createdAt])
  @@index([acknowledgedAt])
}

model PromptTemplate {
  id        Int      @id @default(autoincrement())
  content   String
  updatedAt DateTime @updatedAt
}

/// Answers to the questions customers ask that are not about the menu:
/// allergens, timings, parking, delivery radius, bulk orders, refunds.
///
/// These have nowhere to live today — PromptTemplate is a single free-text row,
/// and growing it until it dominates every prompt is the same scaling problem
/// the menu already has.
///
/// restaurantId is carried from the start. The rest of the schema is
/// single-tenant (see src/tenancy.ts) and retrofitting a tenant key onto a live
/// orders table is a real migration; this table has no rows yet, so the column
/// is free here and one less thing to unpick when the second restaurant lands.
///
/// isPublished defaults to false deliberately. An answer nobody at the
/// restaurant has confirmed must never reach a customer — especially an
/// allergen answer. Drafts are invisible to the bot until somebody signs off.
model KnowledgeArticle {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @default(1)
  question     String   // The canonical phrasing, e.g. "Do you have parking?"
  answer       String   // Exactly what the bot may tell a customer. Blank = unanswered draft.
  keywords     String   @default("") // Comma-separated extra search terms
  category     String?  // "allergens" | "hours" | "location" | "delivery" | "payment" | "policy"
  /// Send the answer word-for-word instead of letting the model rephrase it.
  /// Use for anything where a paraphrase could be wrong in a way that matters:
  /// allergens, refund terms, delivery radius.
  isVerbatim   Boolean  @default(false)
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([restaurantId, question])
  @@index([restaurantId, isPublished])
}

model ToolDefinition {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  description      String
  parametersSchema String   // JSON Schema
  isEnabled        Boolean  @default(true)
  sortOrder        Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// 12. CROSS-INSTANCE TURN SERIALIZATION
// ============================================================================

/// One row per conversation currently being answered, so only one turn runs for
/// a customer at a time.
///
/// This used to be an in-process Map, which held only as long as the bot ran on
/// exactly one instance. On a second Cloud Run instance two messages from the
/// same customer would be answered concurrently — two agent loops mutating the
/// same cart, and two payment links for one order.
///
/// The lock is a lease, not a latch: `expiresAt` lets the next message take over
/// if the holder crashed mid-turn, so a dead instance cannot wedge a customer
/// out of the bot permanently.
model ConversationLock {
  key       String   @id // `${restaurantId}:${phone}`
  holder    String // Unique per acquisition, so a stale holder cannot release a lease it lost.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Messages that arrived while another instance was mid-turn for the customer.
///
/// The lock holder drains these when its turn ends and answers everything as one
/// turn, which is what makes burst-typed orders ("2 biryani" / "1 parotta" /
/// "deliver home") read as a single order rather than three.
model QueuedMessage {
  id        Int      @id @default(autoincrement())
  lockKey   String
  text      String
  createdAt DateTime @default(now())

  @@index([lockKey, createdAt])
}
